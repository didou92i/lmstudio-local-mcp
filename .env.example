# Copier dans .env si nécessaire. Ne jamais ajouter de vrai jeton au dépôt.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234
LM_STUDIO_API_TOKEN=
# Vérification distante au démarrage, puis au plus toutes les heures.
# 0 = vérifier en ligne à chaque appel (plus lent).
LM_MCP_UPDATE_TTL=3600
# Documentation complète : téléchargement initial puis contrôle selon le TTL.
LM_MCP_DOCS_AUTO_SYNC=true
LM_MCP_DOCS_TTL=3600
LM_MCP_TIMEOUT=300
# Plugins LM Studio explicitement activés, séparés par des virgules.
LM_MCP_ALLOWED_INTEGRATIONS=

# Configuration MCP officielle et racines documentaires autorisées.
# LM_MCP_CONFIG_PATH=/chemin/absolu/vers/mcp.json
# LM_MCP_RAG_ROOTS=/chemin/documents:/autre/dossier
# LM_REMOTE_SERVEUR_TOKEN=
